# ─── AI Provider ────────────────────────────────────────────────────────────
# "anthropic" (default) or "gemini"
AI_PROVIDER=anthropic

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Used when AI_PROVIDER=anthropic. Get your key at console.anthropic.com
# Model used: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# ─── Google Gemini ───────────────────────────────────────────────────────────
# Used when AI_PROVIDER=gemini. Get your key at aistudio.google.com
# Default model: gemini-2.5-flash (fast, economical, confirmed available on v1beta)
# Override with any model from: https://generativelanguage.googleapis.com/v1beta/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
